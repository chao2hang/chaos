# chaos default configuration
# Override these values as needed.

# API listen address. Use 127.0.0.1:2030 to restrict access to this machine.
CHAOS_BIND=0.0.0.0:2030

# SQLite database path
CHAOS_DATABASE_URL=sqlite:/var/lib/chaos/chaos.db?mode=rwc

# JWT secret file (auto-created on first run if missing)
CHAOS_JWT_SECRET=/var/lib/chaos/jwt.secret

# dae binary path
CHAOS_DAE_BIN=/usr/lib/chaos/bin/dae

# Real proxy latency tester (bundled with chaos packages)
CHAOS_PROBER_BIN=/usr/lib/chaos/bin/chaos-prober

# dae working directory (config + pid + logs)
CHAOS_DAE_WORK_DIR=/var/lib/chaos/dae

# dae log level written into config.dae (trace|debug|info|warn|error|fatal).
# `info` keeps the console's connection view working; the data plane writes one
# line per proxied connection, so on a busy host raise it to `warn` to trade
# that view for a much smaller log.
# CHAOS_DAE_LOG_LEVEL=info

# Size at which dae.log is rotated (bytes; minimum 1024, default 32 MiB).
# One previous generation is kept, so the work dir holds at most two files.
# CHAOS_DAE_LOG_MAX_BYTES=33554432

# Web assets directory
CHAOS_WEB_DIR=/usr/share/chaos/web

# Auto-start dae on boot (restore last applied config)
CHAOS_AUTOSTART_DAE=1

# GeoIP lookups (sends node addresses to third-party service)
# CHAOS_GEOIP_ENABLED=1

# If geoip.dat/geosite.dat are missing from the dae work dir at startup, chaos
# copies the bundled copies from /usr/share/chaos, or downloads them from v2fly
# (set CHAOS_GEO_DATA_AUTO_FETCH=0 to disable the network fallback).
# CHAOS_GEO_DATA_AUTO_FETCH=1

# Backup archive directory
CHAOS_BACKUP_DIR=/var/lib/chaos/backups
