# chaos default configuration
# Override these values as needed.

# API listen address
CHAOS_BIND=127.0.0.1:2030

# SQLite database path
CHAOS_DATABASE_URL=sqlite:/var/lib/chaos/chaos.db?mode=rwc

# JWT secret file (auto-created on first run if missing)
CHAOS_JWT_SECRET=/var/lib/chaos/jwt.secret

# dae binary path
CHAOS_DAE_BIN=/usr/lib/chaos/bin/dae

# dae working directory (config + pid + logs)
CHAOS_DAE_WORK_DIR=/var/lib/chaos/dae

# Web assets directory
CHAOS_WEB_DIR=/usr/share/chaos/web

# Auto-start dae on boot (restore last applied config)
CHAOS_AUTOSTART_DAE=1

# GeoIP lookups (sends node addresses to third-party service)
# CHAOS_GEOIP_ENABLED=1
