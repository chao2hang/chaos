[Unit]
Description=chaos — control plane for dae
Documentation=https://github.com/chao2hang/chaos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/lib/chaos/bin/chaos-api
EnvironmentFile=-/etc/chaos/chaos.env
WorkingDirectory=/var/lib/chaos
StateDirectory=chaos
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitMEMLOCK=infinity

# Data plane needs elevated privileges for eBPF
# Option A: run as root (simplest)
User=root

# Option B (more secure): run as dedicated user with capabilities
# User=chaos
# AmbientCapabilities=CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN
# CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_SYS_ADMIN

# Hardening
NoNewPrivileges=false
ProtectHome=read-only
ReadWritePaths=/var/lib/chaos

# Clean up dae's netns mount left by unclean exits (reboot mid-upgrade, OOM, kill -9)
ExecStopPost=-/usr/bin/umount /run/netns/daens
ExecStopPost=-/bin/rm -f /run/netns/daens

[Install]
WantedBy=multi-user.target
